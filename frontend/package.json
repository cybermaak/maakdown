{
  "name": "maakdown-frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "benchmark": "node scripts/benchmark-reader.mjs",
    "benchmark:workspace": "node scripts/benchmark-workspace.mjs",
    "visual-smoke": "node scripts/visual-smoke.mjs",
    "uat": "playwright test --config playwright.uat.config.ts",
    "uat:headed": "playwright test --config playwright.uat.config.ts --headed",
    "uat:report": "playwright show-report uat-results/html"
  },
  "dependencies": {
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@lucide/svelte": "^1.17.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "github-slugger": "^2.0.0",
    "hast-util-to-html": "^9.0.5",
    "highlight.js": "^11.11.1",
    "js-yaml": "^4.2.0",
    "linkedom": "^0.18.12",
    "mermaid": "^11.15.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-frontmatter": "^5.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.2.0",
    "svelte": "^5.56.2",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "vite": "^8.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.60.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^25.0.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.60.0",
    "svelte-check": "^4.6.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  }
}
