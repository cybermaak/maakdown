# Copy to .env (gitignored) and fill in. Used by the local release scripts.
# These are examples only — never put real secrets in git.

# --- macOS signing + notarization (scripts/release-mac.sh) -------------------
# The Developer ID Application identity as it appears in:
#   security find-identity -v -p codesigning
MAAKDOWN_MACOS_CODESIGN_IDENTITY="Developer ID Application: Your Name (TEAMID)"

# Name of the keychain profile that holds your notarization credentials, created
# once (and reusable across projects) with either an App Store Connect API key:
#   xcrun notarytool store-credentials <profile> \
#     --key AuthKey_XXXX.p8 --key-id XXXXXXXXXX --issuer <issuer-uuid>
# or an Apple ID + app-specific password:
#   xcrun notarytool store-credentials <profile> \
#     --apple-id you@example.com --team-id TEAMID --password xxxx-xxxx-xxxx-xxxx
# The credentials stay in the keychain; only the profile name lives here.
MAAKDOWN_NOTARY_PROFILE=

# Optional: override the entitlements file (defaults to build/darwin/entitlements.plist).
# MAAKDOWN_MACOS_ENTITLEMENTS=build/darwin/entitlements.plist

# GitHub publishing reuses your existing `gh` CLI login (gh auth token) — there
# is no token to put here. Ensure `gh auth status` shows write access to the repo.

# --- Windows signing (future: scripts/sign-windows.ps1) ----------------------
# Not active until a code-signing certificate is available; builds are unsigned.
MAAKDOWN_WINDOWS_CERT_PATH=
MAAKDOWN_WINDOWS_CERT_PASSWORD=
MAAKDOWN_WINDOWS_TIMESTAMP_URL=http://timestamp.digicert.com
